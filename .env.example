# ─────────────────────────────────────────────────────────────────────────────
# copilot-dispatch — Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Jira ──────────────────────────────────────────────────────────────────────

# Atlassian instance URL (no trailing slash)
JIRA_BASE_URL=https://yourteam.atlassian.net

# Jira account email
JIRA_EMAIL=you@example.com

# Jira API token — create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token

# Project key prefix (e.g. "SCRUM" for SCRUM-123)
JIRA_PROJECT_KEY=SCRUM

# Sprint name prefix to match active sprint (default: "Sprint")
JIRA_SPRINT_PREFIX=Sprint

# Comma-separated statuses to pick up (default: "To Do")
JIRA_PICK_STATUSES=To Do

# Only pick issues assigned to this Jira account ID — leave blank for all
# Find your account ID: https://yourteam.atlassian.net/rest/api/3/myself
JIRA_ASSIGNEE_FILTER=

# Transition picked issues to this status — leave blank to skip
JIRA_TRANSITION_TO=In Progress

# ── GitHub ────────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (repo + issues scopes)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-token-here

# Target repository in "owner/repo" format
GITHUB_REPO=your-org/your-repo

# ── Anthropic ─────────────────────────────────────────────────────────────────

# Anthropic API key — create at https://console.anthropic.com/
# Used for complexity analysis (haiku) and spec generation (sonnet)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Project context for spec generation ───────────────────────────────────────

# Short description of your tech stack — used in the enricher system prompt
TECH_STACK=TypeScript monorepo with React frontend and Express/PostgreSQL backend

# Optional: additional architecture notes injected into the enricher prompt
# Use this for project-specific conventions the AI should follow
ARCH_NOTES=

# ── Automation limits ─────────────────────────────────────────────────────────

# Max tasks to auto-process per pipeline run (prevents runaway)
MAX_AUTO_TASKS=3

# Minimum confidence % to auto-create a GitHub issue for a SIMPLE task
CONFIDENCE_THRESHOLD=75
